{
  "name": "lantern-api",
  "version": "0.0.2",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run type && bun build src/index.ts --compile --outfile build/lantern",
    "start": "build/lantern",
    "fmt": "prettier --write .",
    "type": "tsc --noEmit",
    "migrate-dev": "bunx -b mikro-orm schema:create --run",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.11",
    "@mikro-orm/core": "^6.5.9",
    "@mikro-orm/reflection": "^6.5.9",
    "@mikro-orm/sqlite": "^6.5.9",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "elysia": "latest",
    "preact": "^10.27.2",
    "preact-render-to-string": "^6.6.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.5.9",
    "@mikro-orm/migrations": "^6.5.9",
    "bun-types": "latest",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@sinclair/typebox-codegen": "^0.11.1",
  },
  "type": "module",
  "module": "src/index.js"
}